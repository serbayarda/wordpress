{
  "name": "content-upload-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "once": "tsx src/index.ts --once",
    "dry-run": "tsx src/index.ts --dry-run",
    "dry-run:no-images": "tsx src/index.ts --dry-run --skip-images",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.1",
    "googleapis": "^144.0.0",
    "mammoth": "^1.8.0",
    "node-html-parser": "^6.1.13",
    "openai": "^4.73.0",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

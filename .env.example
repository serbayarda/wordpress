# Google Drive (service account JSON, base64-encoded)
GOOGLE_SERVICE_ACCOUNT_B64=

# OpenAI
OPENAI_API_KEY=

# Gemini (only needed if a brand uses image.provider="gemini")
GEMINI_API_KEY=

# Polling interval in seconds
POLL_INTERVAL_SECONDS=120

# Path to brands directory
BRANDS_DIR=./brands

# Where the resumable state file lives (one JSON per brand)
STATE_DIR=./state

# WordPress credentials per brand (env var name = <BRAND_ID_UPPER>_WP_APP_PASSWORD)
# Example for the "macfit" brand:
MACFIT_WP_USERNAME=
MACFIT_WP_APP_PASSWORD=
